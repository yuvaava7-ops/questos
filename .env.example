# Create a Supabase project, run supabase/schema.sql in its SQL editor, then
# copy this file to .env.local and fill these in from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build the email-confirmation redirect link (Authentication > Email
# templates in Supabase). Set to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# For Claude-generated skill trees / goal breakdown (Phase 3+)
ANTHROPIC_API_KEY=

# For GitHub commit pulling (Phase 2+)
GITHUB_TOKEN=
