# Create a Supabase project, run supabase/schema.sql in its SQL editor, then
# copy this file to .env.local and fill these in from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Enables the MCP endpoint (/api/mcp), which authenticates with
# QuestOS API tokens instead of a login session. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, not used yet: in-app Claude API calls. Skill trees are currently
# generated by Claude through the MCP endpoint instead.
ANTHROPIC_API_KEY=

# For GitHub commit pulling (Phase 2+)
GITHUB_TOKEN=
